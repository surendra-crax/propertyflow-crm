generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  MANAGER
  AGENT
  BROKER
}

enum ProjectStatus {
  PRELAUNCH
  ONGOING
  COMPLETED
}

enum LeadStatus {
  NEW
  CONTACTED
  FOLLOW_UP
  SITE_VISIT_DONE
  NEGOTIATION
  CLOSED_WON
  CLOSED_LOST
}

enum LeadSource {
  WEBSITE
  FACEBOOK_ADS
  GOOGLE_ADS
  BROKER
  REFERRAL
  WALK_IN
  HOUSING_COM
  MAGICBRICKS
  NINETY_NINE_ACRES
  WEBHOOK
}

enum LeadTemperature {
  HOT
  WARM
  COLD
}

enum PropertyType {
  FLAT
  VILLA
  PLOT
  COMMERCIAL
}

enum VisitStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum PaymentStage {
  TOKEN
  BOOKING
  AGREEMENT
  FINAL_PAYMENT
}

enum UnitStatus {
  AVAILABLE
  RESERVED
  SOLD
  MGMT_QUOTA
}

enum DocumentType {
  PDF
  IMAGE
  DOCUMENT
}

enum EntityType {
  LEAD
  DEAL
  PROJECT
}

enum IntegrationType {
  FACEBOOK
  GOOGLE
  NINETY_NINE_ACRES
  MAGICBRICKS
  HOUSING_COM
  WEBSITE
  WEBHOOK
  TWILIO_WHATSAPP
  TWILIO_SMS
  META_WHATSAPP
  RESEND
  SENDGRID
  AWS_S3
}

model TenantConfig {
  id             String  @id @default(uuid())
  companyName    String
  logoUrl        String?
  brandColor     String?
  emailSignature String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Integration {
  id          String          @id @default(uuid())
  type        IntegrationType
  isActive    Boolean         @default(false)
  credentials Json?
  config      Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  phone     String?
  role      Role
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leads         Lead[]         @relation("AgentLeads")
  managedProj   Project[]      @relation("ManagerProjects")
  visits        SiteVisit[]
  activities    Activity[]
  notifications Notification[]
}

model Project {
  id             String        @id @default(uuid())
  name           String
  location       String
  minPrice       Float
  maxPrice       Float
  totalUnits     Int
  availableUnits Int
  status         ProjectStatus
  coverImage     String?
  gallery        String[]

  managerId String
  manager   User   @relation("ManagerProjects", fields: [managerId], references: [id])

  leads Lead[]
  deals Deal[]
  units Unit[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, location])
}

model Unit {
  id         String     @id @default(uuid())
  unitNumber String
  floor      String
  type       String
  area       Float
  price      Float
  status     UnitStatus @default(AVAILABLE)

  projectId String
  project   Project @relation(fields: [projectId], references: [id])

  deals Deal[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Lead {
  id           String           @id @default(uuid())
  fullName     String
  phone        String
  email        String?
  budgetMin    Float
  budgetMax    Float
  propertyType PropertyType
  status       LeadStatus
  source       LeadSource
  notes        String?
  nextFollowup DateTime?
  score        Int              @default(0)
  temperature  LeadTemperature?

  projectId String
  project   Project @relation(fields: [projectId], references: [id])

  assignedAgentId String
  assignedAgent   User   @relation("AgentLeads", fields: [assignedAgentId], references: [id])

  visits     SiteVisit[]
  activities Activity[]
  deal       Deal?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([assignedAgentId])
  @@index([projectId])
  @@index([createdAt])
}

model SiteVisit {
  id        String      @id @default(uuid())
  leadId    String
  agentId   String
  visitDate DateTime
  status    VisitStatus
  notes     String?

  lead  Lead @relation(fields: [leadId], references: [id])
  agent User @relation(fields: [agentId], references: [id])

  createdAt DateTime @default(now())
}

model Broker {
  id                   String  @id @default(uuid())
  name                 String
  company              String
  phone                String
  email                String?
  commissionPercentage Float?
  commission           Float

  deals              Deal[]
  commissionPayments CommissionPayment[]

  createdAt DateTime @default(now())
}

model Deal {
  id               String   @id @default(uuid())
  leadId           String   @unique
  projectId        String
  unitId           String?
  saleValue        Float
  brokerId         String?
  commissionAmount Float
  notes            String?
  closedAt         DateTime

  lead     Lead      @relation(fields: [leadId], references: [id])
  project  Project   @relation(fields: [projectId], references: [id])
  unit     Unit?     @relation(fields: [unitId], references: [id])
  broker   Broker?   @relation(fields: [brokerId], references: [id])
  payments Payment[]

  createdAt DateTime @default(now())
}

model Payment {
  id            String       @id @default(uuid())
  amount        Float
  date          DateTime
  paymentMethod String
  paymentStage  PaymentStage
  notes         String?

  dealId String
  deal   Deal   @relation(fields: [dealId], references: [id])

  createdAt DateTime @default(now())
}

model CommissionPayment {
  id       String   @id @default(uuid())
  brokerId String
  amount   Float
  date     DateTime
  notes    String?

  broker Broker @relation(fields: [brokerId], references: [id])

  createdAt DateTime @default(now())
}

model Activity {
  id          String @id @default(uuid())
  leadId      String
  userId      String
  type        String
  description String

  lead Lead @relation(fields: [leadId], references: [id])
  user User @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
}

model Notification {
  id      String  @id @default(uuid())
  userId  String
  title   String
  message String
  isRead  Boolean @default(false)

  user User @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
}

model ContactLead {
  id        String   @id @default(uuid())
  name      String
  company   String?
  email     String
  phone     String
  teamSize  String?
  message   String?
  status    String   @default("NEW")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AutomationRule {
  id        String  @id @default(uuid())
  name      String
  condition String
  action    String
  config    Json?
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Document {
  id         String       @id @default(uuid())
  name       String
  url        String
  type       DocumentType
  entityType EntityType
  entityId   String

  createdAt DateTime @default(now())
}

model MessageTemplate {
  id   String @id @default(uuid())
  name String
  body String
  type String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id         String  @id @default(uuid())
  userId     String?
  userEmail  String?
  action     String
  entityType String?
  entityId   String?
  oldValue   Json?
  newValue   Json?
  ipAddress  String?

  createdAt DateTime @default(now())
}

model ApiKey {
  id        String    @id @default(uuid())
  label     String
  keyHash   String    @unique
  isActive  Boolean   @default(true)
  expiresAt DateTime?

  createdAt DateTime @default(now())
}

model Campaign {
  id              String   @id @default(uuid())
  name            String
  source          String
  adSpend         Float    @default(0)
  leadsGenerated  Int      @default(0)
  visitsGenerated Int      @default(0)
  bookings        Int      @default(0)
  startDate       DateTime?
  endDate         DateTime?
  notes           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

